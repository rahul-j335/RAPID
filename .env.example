# RAPID Environment Configuration Template
# Copy this file to .env and replace with your actual keys

# Application Port & Mode
VITE_APP_ENV=development
VITE_PORT=5173

# Telemetry & Sensor Streaming API
VITE_SENSOR_API_URL=https://api.rapid-surge.org/v1/telemetry
VITE_SIMULATION_INTERVAL_MS=3000

# Geo & Map Services
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ZOOM_DEFAULT=11
